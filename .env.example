# Copy this file to .env and fill in your own values. Never commit .env.
# Keys use "Jira__X" so they map to the "Jira" section in appsettings.json and override it.
Jira__BaseUrl=https://yourcompany.atlassian.net
Jira__Email=you@example.com
Jira__ApiToken=your-api-token-here
Jira__DefaultProjectKey=ABC
